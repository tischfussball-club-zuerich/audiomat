# User service: install to ~/.config/systemd/user/tfcz-audio.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now tfcz-audio
# PipeWire runs per user session, so this must be a *user* unit, not a system one.
# If the box should route audio without a graphical login, also run:
#   loginctl enable-linger $USER
[Unit]
Description=TFCZ audio router (PipeWire intercom, HDMI feed, OBS virtual mic)
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service
# never give up restarting, no matter how often it fails
StartLimitIntervalSec=0

[Service]
Type=notify
ExecStart=%h/.local/bin/tfcz-audio run
# the daemon pings the watchdog every few seconds from its supervisor loop;
# a hung process is killed and restarted by systemd
WatchdogSec=30
NotifyAccess=main
Restart=always
RestartSec=2
TimeoutStopSec=10
# pw-loopback / pw-record children die together with the daemon
KillMode=control-group
# routing must keep working when the daemon is starved; it only talks to PipeWire
Nice=-5

[Install]
WantedBy=default.target
